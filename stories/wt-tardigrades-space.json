 "beats": [
  {
   "text": "In 2007, scientists sent tiny animals into open space. No suit. No protection.",
   "broll": [
    "rocket launch",
    "satellite orbit earth"
   ],
   "start": 0.25,
   "end": 7.25,
   "video": "broll/wt-tardigrades-space-t0-0.mp4"
  },
  {
   "text": "They were tardigrades, also called water bears, less than a millimeter long.",
   "broll": [
    "tardigrade",
    "water bear microscope"
   ],
   "start": 7.25,
   "end": 11.64,
   "video": "broll/wt-tardigrades-space-t0-1.mp4"
  },
  {
   "text": "For ten days they rode on the outside of a satellite, in the vacuum of space.",
   "broll": [
    "earth from space",
    "satellite space"
   ],
   "start": 11.64,
   "end": 16.18,
   "video": "broll/wt-tardigrades-space-t0-2.mp4"
  },
  {
   "text": "Back on Earth, many of them woke up. Some even laid eggs that hatched.",
   "broll": [
    "tardigrade",
    "microscope organism"
   ],
   "impact": true,
   "start": 16.18,
   "end": 20.47,
   "video": "broll/wt-tardigrades-space-t0-3.mp4"
  },
  {
   "text": "Their trick: they dry out, curl into a ball, and almost stop living.",
   "broll": [
    "moss close up",
    "microscope water"
   ],
   "start": 20.47,
   "end": 24.39,
   "video": "broll/wt-tardigrades-space-t1-0.mp4"
  },
  {
   "text": "The first animals known to survive open space were smaller than a grain of sand.",
   "broll": [
    "sand grains macro",
    "tardigrade"
   ],
   "start": 24.39,
   "end": 30.0
  }
 ],
